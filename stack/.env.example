# Copied to /opt/automation/.env by deploy.sh, which fills in QDRANT_API_KEY.
# Edit there, then: cd /opt/automation && docker compose up -d

# Qdrant API key: sent as the `api-key` header. deploy.sh generates one.
QDRANT_API_KEY=

# Hostname you open n8n with (the VM's Tailscale name).
N8N_HOST=ai
TZ=Africa/Johannesburg

# Model pulled into Ollama by deploy.sh. `mistral` is Mistral 7B, Q4_K_M.
OLLAMA_MODEL=mistral

# Resource limits for the 12GB / 4-core VM (about 9GB to containers, the rest to the OS).
OLLAMA_CPUS=3
OLLAMA_MEM=6g
QDRANT_CPUS=1
QDRANT_MEM=1536m
N8N_CPUS=1
N8N_MEM=1536m
N8N_HEAP_MB=1024
