# Copied to /opt/automation/.env by deploy.sh, which fills in every empty secret.
# Edit there, then: cd /opt/automation && docker compose up -d

# Qdrant API key: sent as the `api-key` header. deploy.sh generates one.
QDRANT_API_KEY=

# Hostname you open n8n with (the VM's Tailscale name).
N8N_HOST=ai
TZ=Africa/Johannesburg

# Model pulled into Ollama by deploy.sh. `mistral` is Mistral 7B, Q4_K_M.
OLLAMA_MODEL=mistral
# How long a model stays in RAM after its last request (Ollama's default is 5m).
OLLAMA_KEEP_ALIVE=2m

# WhatsApp (WAHA). deploy.sh generates the three secrets.
# API key: the `X-Api-Key` header n8n sends. Dashboard: http://ai:3000/dashboard, user `admin`.
# Hook secret: the `X-Waha-Secret` header WAHA sends to n8n's webhook.
WAHA_VERSION=2026.9.2
WAHA_API_KEY=
WAHA_DASHBOARD_PASSWORD=
WAHA_HOOK_SECRET=

# Telegram bot that messages the owner (work-email alerts). Optional. The token
# comes from @BotFather; n8n-credentials.sh turns it into the n8n credential
# "RI Email". Leave empty if no workflow sends to Telegram.
TELEGRAM_BOT_TOKEN=

# The bridge (Telegram -> n8n, and n8n -> mail relay). Started by deploy.sh only
# when TELEGRAM_BOT_TOKEN is set. OWNER_CHAT_ID: the one Telegram chat whose
# messages reach n8n (a bot's getUpdates shows it). BRIDGE_SECRET: deploy.sh
# generates it; n8n-credentials.sh turns it into the credential "Mail bridge
# secret" (header X-Bridge-Secret), used in both directions.
OWNER_CHAT_ID=
BRIDGE_SECRET=
# Outgoing mail: the relay a mail client on this account already uses, with
# STARTTLS on 587. SMTP_TLS_VERIFY=false only for a relay whose certificate
# chain doesn't verify; the connection is still encrypted. MAIL_FROM is the
# address mail is sent as.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Quote a password that has spaces or special characters: SMTP_PASSWORD='p a$s'.
# A value pasted from elsewhere can carry a hidden carriage return; Compose then
# refuses the whole file ("unexpected character"). stack/bridge/relay-test.sh
# shows the password's length and first/last character without printing it.
SMTP_PASSWORD=
SMTP_TLS_VERIFY=true
MAIL_FROM=
MAIL_FROM_NAME=

# Resource limits for the 12GB / 4-core VM. The budget and the measurements behind
# it are in docs/SYSTEM-DESIGN.md; change them there too.
OLLAMA_CPUS=3
OLLAMA_MEM=6g
QDRANT_CPUS=1
QDRANT_MEM=1536m
N8N_CPUS=1
N8N_MEM=1536m
N8N_HEAP_MB=1024
# Workflows allowed to run at the same time; the rest queue.
N8N_CONCURRENCY=5
WAHA_CPUS=0.5
WAHA_MEM=768m
BRIDGE_CPUS=0.25
BRIDGE_MEM=128m
