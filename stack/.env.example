# Copied to /opt/automation/.env by deploy.sh, which fills in every empty secret.
# Edit there, then: cd /opt/automation && docker compose up -d

# Qdrant API key: sent as the `api-key` header. deploy.sh generates one.
QDRANT_API_KEY=

# Hostname you open n8n with (the VM's Tailscale name).
N8N_HOST=ai
TZ=Africa/Johannesburg

# Model pulled into Ollama by deploy.sh. `mistral` is Mistral 7B, Q4_K_M.
OLLAMA_MODEL=mistral
# How long a model stays in RAM after its last request (Ollama's default is 5m).
OLLAMA_KEEP_ALIVE=2m

# WhatsApp (WAHA). deploy.sh generates the three secrets.
# API key: the `X-Api-Key` header n8n sends. Dashboard: http://ai:3000/dashboard, user `admin`.
# Hook secret: the `X-Waha-Secret` header WAHA sends to n8n's webhook.
WAHA_VERSION=2026.9.2
WAHA_API_KEY=
WAHA_DASHBOARD_PASSWORD=
WAHA_HOOK_SECRET=

# Resource limits for the 12GB / 4-core VM. The budget and the measurements behind
# it are in docs/SYSTEM-DESIGN.md; change them there too.
OLLAMA_CPUS=3
OLLAMA_MEM=6g
QDRANT_CPUS=1
QDRANT_MEM=1536m
N8N_CPUS=1
N8N_MEM=1536m
N8N_HEAP_MB=1024
# Workflows allowed to run at the same time; the rest queue.
N8N_CONCURRENCY=5
WAHA_CPUS=0.5
WAHA_MEM=768m
